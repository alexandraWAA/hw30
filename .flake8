[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    migrations,
    venv,
    .venv,
    build,
    dist,
    .eggs,
    *.egg
per-file-ignores =
    */migrations/*: E501
    */__init__.py: F401
max-complexity = 10
count = true
statistics = true
show-source = true